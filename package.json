{
  "name": "graphlint",
  "version": "0.1.0",
  "description": "Static analyzer for agent workflow specs. Catches barrier misuse, correlated verifiers, missing schemas and non-terminating cycles before a token is spent.",
  "keywords": ["agent", "workflow", "linter", "static-analysis", "llm", "claude", "sarif"],
  "license": "MIT",
  "author": "Erwin Lejeune",
  "repository": { "type": "git", "url": "git+https://github.com/Unchained-Labs/graphlint.git" },
  "homepage": "https://unchained-labs.github.io/graphlint/",
  "bugs": "https://github.com/Unchained-Labs/graphlint/issues",
  "type": "module",
  "engines": { "node": ">=20" },
  "bin": { "graphlint": "./dist/cli.js" },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" } },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "node --experimental-strip-types src/cli.ts check test/fixtures/good",
    "prepublishOnly": "pnpm build && pnpm test"
  },
  "dependencies": { "acorn": "^8.12.1", "acorn-walk": "^8.3.4" },
  "devDependencies": { "@types/node": "^22.7.4", "typescript": "^5.6.2", "vitest": "^2.1.2" },
  "packageManager": "pnpm@9.12.0"
}
